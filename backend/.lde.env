# Local Dev Environment — points the backend at docker-compose.external-services.yaml
# Bring services up:  docker compose -f docker-compose.external-services.yaml up -d

# Ollama URL for the backend to connect
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

WEBUI_SECRET_KEY='AnQgLDM6W84NU'
CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- External services (docker-compose.external-services.yaml) ---

# Postgres (service: postgres)
DATABASE_URL='postgresql://openwebui:openwebui@localhost:5432/openwebui'

# MinIO / S3-compatible object storage (service: minio)
STORAGE_PROVIDER='s3'
S3_ENDPOINT_URL='http://localhost:9000'
S3_ACCESS_KEY_ID='minioadmin'
S3_SECRET_ACCESS_KEY='minioadmin'
S3_BUCKET_NAME='open-webui'
S3_REGION_NAME='us-east-1'

# MinIO bucket bootstrap (used by dev.sh to create the bucket)
MINIO_CONTAINER='minio'
MINIO_ENDPOINT='http://localhost:9000'
MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='minioadmin'

# ELASTICSEARCH_INDEX_PREFIX='open_webui_collections'

ENABLE_INGESTION_ANALYSIS=true

SQLALCHEMY_DATABASE_URL='postgresql://openwebui:openwebui@localhost:5432/openwebui'


# Description: Disables Open WebUI's network connections for update checks and automatic model downloads.
OFFLINE_MODE=true

# Tells Hugging Face whether we want to launch in offline mode, so to not connect to hugging face and prevent all automatic model download
HF_HUB_OFFLINE=1

#Resets the config.json file on startup.
RESET_CONFIG_ON_START=false

# Enables safe mode, which disables potentially unsafe features, deactivating all functions.
SAFE_MODE=true


#### VECTOR DATABASE CONFIGURATION
# Elasticsearch vector store (service: elasticsearch)
# security is disabled in the compose file, so use http:// and no credentials
VECTOR_DB='elasticsearch'
ELASTICSEARCH_URL='http://localhost:9200'

# ELASTICSEARCH_API_KEY
# ELASTICSEARCH_CA_CERTS
# ELASTICSEARCH_INDEX_PREFIX
# ELASTICSEARCH_PASSWORD
# ELASTICSEARCH_USERNAME

#  Enables automatic context compaction. When a chat's estimated context exceeds CONTEXT_COMPACTION_TOKEN_THRESHOLD, older messages are summarized into a checkpoint and dropped from what is sent to the model, while recent messages are kept, so long conversations stay within the model's context window. Can also be toggled in Admin Panel > Settings > Interface.
ENABLE_CONTEXT_COMPACTION=true
# CONTEXT_COMPACTION_TOKEN_THRESHOLD default 80000

# https://docs.openwebui.com/reference/env-configuration/#retrieval-augmented-generation-rag
##### RAG Content Extraction Engine 
# CONTENT_EXTRACTION_ENGINE - external, tika, docling, document_intelligence, mistral_ocr, datalab_marker, mineru, paddleocr_vl
# DOCLING_PARAMS
# {
#   "do_ocr": true,
#   "ocr_engine": "tesseract",
#   "ocr_lang": ["eng", "fra", "deu", "spa"],
#   "force_ocr": false,
#   "pdf_backend": "dlparse_v4",
#   "table_mode": "accurate",
#   "do_picture_description": true,
#   "picture_description_mode": "api",
#   "vlm_pipeline_model_api": "openai://gpt-4o"
# }


# RAG_EMBEDDING_ENGINE - ollama, openai, azure_openai
# RAG_EMBEDDING_MODEL
# RAG_TOP_K
# RAG_RELEVANCE_THRESHOLD
# ENABLE_RAG_HYBRID_SEARCH

#Description: When enabled, adds a kb_exec tool that lets the model interact with knowledge bases through shell-style commands (ls, tree, cat, head, tail, sed, grep, find, wc, stat) with pipe support (e.g. grep "auth" | head -5). Directory-aware: ls docs/ lists a subdirectory, tree renders a recursive view, grep "text" docs/ scopes the search, and files can be referenced by path (docs/api/auth.md), filename, or file ID.
# ENABLE_KB_EXEC  
# RAG_HYBRID_BM25_WEIGHT (default 0.5)
# ENABLE_RAG_HYBRID_SEARCH_ENRICHED_TEXTS

# https://docs.openwebui.com/reference/env-configuration/#document-processing
##### Document Processing
# CHUNK_OVERLAP (default 10000)
# CHUNK_SIZE (default 100)

# Chunks smaller than this threshold will be intelligently merged with neighboring chunks when possible. This helps prevent tiny, low-quality fragments that can hurt retrieval performance and waste embedding resources. This feature only works when ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER is enabled. Set to 0 to disable merging. For more information on the benefits and configuration, see the RAG guide.
# CHUNK_MIN_SIZE_TARGET

PDF_LOADER_MODE=single
# PDF_LOADER_MODE Description: Controls how PDFs are loaded and split into documents when using the default content extraction engine (PyPDFLoader). Page mode creates one document per page, while single mode combines all pages into one document, which can improve chunking quality when content spans across page boundaries. This setting has no effect when using external content extraction engines like Tika, Docling, Document Intelligence, MinerU, or Mistral OCR, as those engines have their own document handling logic.